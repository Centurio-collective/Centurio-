# Copy the values below into Netlify (Site settings -> Environment variables)
# -- do NOT commit a real .env file with actual secrets to this repo.

# Supabase project URL, e.g. https://zjfyikiitcweyjszuonl.supabase.co
SUPABASE_URL=

# Supabase service_role secret key (Project Settings -> API -> Project API keys
# -> service_role). Bypasses Row Level Security -- keep this server-side only,
# never expose it to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=
